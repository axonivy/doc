{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>axonivy/renovate-config"
  ],
  "packageRules": [
    {
      "matchPackageNames" :[
        "org.apache.maven.*",
        "org.codehaus.mojo:*",
        "maven"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": ["ch.ivyteam.*:*"],
      "enabled": false
    }
  ]
}
  