digraph adaptive_case_management {
  graph [
    bgcolor="transparent"
    rankdir=LR
    nodesep=0.45
    ranksep=0.85
    pad=0.15
    compound=true
    fontname="Roboto,Helvetica Neue,Arial,sans-serif"
  ]

  node [
    color="#777777"
    fontcolor="#6d7280"
    fontname="Roboto,Helvetica Neue,Arial,sans-serif"
    fontsize=14
  ]

  edge [
    color="#777777"
    penwidth=1
  ]

  subgraph cluster_business_case {
    label="Business Case"
    labelloc="t"
    labeljust="l"
    color="#bedb47"
    penwidth=1
    margin=18

    subgraph cluster_cases {
      label="Cases"
      labelloc="t"
      labeljust="l"
      color="#bedb47"
      penwidth=1
      margin=18

      subgraph cluster_tasks {
        label="Tasks"
        labelloc="t"
        labeljust="l"
        color="#bedb47"
        fillcolor="#bedb47"
        style="filled"
        penwidth=1
        margin=18

        task_1 [shape=note label="" width=0.55 height=0.55 style="filled" fillcolor="white"]
        task_2 [shape=note label="" width=0.55 height=0.55 style="filled" fillcolor="white"]
        task_3 [shape=note label="" width=0.55 height=0.55 style="filled" fillcolor="white"]
        task_4 [shape=note label="" width=0.55 height=0.55 style="filled" fillcolor="white"]
        task_5 [shape=note label="" width=0.55 height=0.55 style="filled" fillcolor="white"]
        task_6 [shape=note label="" width=0.55 height=0.55 style="filled" fillcolor="white"]

        { rank=same; task_1; task_2; task_3 }
        { rank=same; task_4; task_5; task_6 }
        task_1 -> task_2 -> task_3 [style=invis weight=10]
        task_4 -> task_5 -> task_6 [style=invis weight=10]
        task_1 -> task_4 [style=invis weight=10]
      }
    }

    business_data [shape=cylinder label="Business\nData" style="filled" fillcolor="#bedb47" fontcolor="white" width=1.45 height=0.85]
    task_5 -> business_data [style=invis weight=10 minlen=2]
    case_map_anchor [shape=point label="" style=invis width=0 height=0]
    business_data -> case_map_anchor [style=invis weight=10]
  }

  case_map [shape=box label="Case Map" style="filled" fillcolor="#bedb47" fontcolor="white" color="#bedb47" width=1.55 height=0.75]

  case_map_anchor -> case_map [arrowhead=none color="#777777" penwidth=1.2 style=solid minlen=2 ltail=cluster_business_case]
}